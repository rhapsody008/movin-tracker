{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::zy-condo-board/*"
    },
    {
      "Sid": "StorageTestCleanup",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::zy-condo-board/_probe/*"
    },
    {
      "Sid": "ListForHeadAnd404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::zy-condo-board"
    },
    {
      "Sid": "DocumentsAreReadOnlyForTheApp",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::zy-condo-board/docs/raw/*"
    }
  ]
}
