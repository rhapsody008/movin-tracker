# syntax=docker/dockerfile:1

# `make -C app test` runs in this image: the pinned Node 24 plus the poppler
# tools the documents converter shells out to, so src/docs/convert tests run
# against the real tools instead of skipping (brief T1.5a; decisions.md, "Run
# T1-T3 unattended"). Same packages as the Go runtime image (Dockerfile:34-36).
# The sources are mounted at /app by docker-compose.yml, not copied in.
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5

# fc-cache -f: fontconfig's cache is built here, so a render of a drawing
# without embedded fonts cannot log "No writable cache directories" to stderr
# and pollute the last stderr line an error message carries (docs-spec §9.11).
RUN apk add --no-cache "poppler-utils~25.12" font-dejavu fontconfig \
 && fc-cache -f
