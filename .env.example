# Copy to .env (make dev does this for you and fills SETTINGS_SECRET).
# .env is git-ignored. Under docker compose, the S3_* and AWS_* values for
# MinIO are set in docker-compose.yml and override anything here.

# --- S3 (production values; local dev uses MinIO from compose) ---
S3_BUCKET=movin-dev
S3_PREFIX=dev
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=          # omit when a role is available (IRSA, instance profile)
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=            # local dev only, e.g. http://minio:9000

# --- LLM defaults (the settings drawer overrides these) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_SEC=60
# LLM_MAX_TOOL_ROUNDS=5
# LLM_STREAMING=true

# Fernet key that encrypts the API key saved from the settings drawer.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
SETTINGS_SECRET=

# --- Auth ---
AUTH_HEADER=X-Forwarded-Email
ALLOWED_EMAILS=
# Local dev only: the user to act as when no proxy sets AUTH_HEADER.
# Never set this in production.
DEV_EMAIL=dev@localhost

TZ=Asia/Singapore
# LISTEN_ADDR=:8080
# LOG_LEVEL=info
