# Copy to .env (make dev does this for you and fills SETTINGS_SECRET).
# .env is git-ignored.

# --- S3: the one real bucket. Dev and production share it (no prefix), so
# whatever you do locally changes your real data. Keys: the IAM user scoped
# by deploy/iam-policy.json. `make test` uses its own MinIO, never these. ---
S3_BUCKET=
S3_PREFIX=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM defaults (Settings → LLM on the web page overrides these) ---
# Local vMLX/Ollama on this Mac, seen from inside Docker:
#   LLM_BASE_URL=http://host.docker.internal:8081/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_STREAMING=true
# Thinking models (Qwen3 on vMLX/vLLM): think only for messages that start
# with /think. Not for OpenAI.
# LLM_THINK_ON_DEMAND=true

# Fernet key that encrypts the API key saved on the web page (Settings → LLM).
# Dev and production share settings.json, so use the same key in both and
# keep it stable; with a different key the saved LLM key can't be read.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
SETTINGS_SECRET=

# --- Auth ---
AUTH_HEADER=X-Forwarded-Email
ALLOWED_EMAILS=
# Local dev only: the user to act as when no proxy sets AUTH_HEADER.
# Never set this in production.
DEV_EMAIL=dev@localhost

# --- Telegram (the bot runs only when the token is set) ---
# Token from @BotFather (/newbot). Also run /setprivacy → Disable so the bot
# sees ordinary messages in your group. Only one running copy may use a token:
# once production runs the bot, leave this empty locally.
TELEGRAM_BOT_TOKEN=
# Default allowlist; Settings → Telegram on the web page replaces it.
# People as id=name (the name is what entries show as "by"):
TELEGRAM_ALLOWED_IDS=
# Group chat IDs (they start with -):
TELEGRAM_ALLOWED_CHATS=

TZ=Asia/Singapore
# LISTEN_ADDR=:8080
# LOG_LEVEL=info
