flex","master bedroom","bedroom 2","bedroom 3","master bathroom","bathroom 2","balcony","whole-house"]},"category":{"type":"string"},"status":{"type":"string","enum":["idea","shortlisted","decided","done","todo","doing"]},"estimate":{"type":"number","description":"SGD quote or expected price"},"actual":{"type":"number","description":"SGD paid so far"},"vendor":{"type":"string"},"date":{"type":"string","description":"YYYY-MM-DD"},"time":{"type":"string","description":"HH:MM 24h; needs a date"},"source":{"type":"string"},"notes":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},"milestone":{"type":"boolean","description":"a notable step for the milestones history"},"completed":{"type":"string","description":"YYYY-MM-DD it was done; set automatically when status becomes done"}},"required":["kind","title"]}}},"required":["entries"]}}},{"type":"function","function":{"name":"update_entry","description":"Change fields of an existing entry by id. Only pass fields that change; null clears a field. archived=true drops it from view (recoverable).","parameters":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["idea","decision","task","note","question"]},"title":{"type":"string","description":"short, specific"},"room":{"type":"string","enum":["","living","dining","dry kitchen","wet kitchen","flex","master bedroom","bedroom 2","bedroom 3","master bathroom","bathroom 2","balcony","whole-house"]},"category":{"type":"string"},"status":{"type":"string","enum":["idea","shortlisted","decided","done","todo","doing"]},"estimate":{"type":"number","description":"SGD quote or expected price"},"actual":{"type":"number","description":"SGD paid so far"},"vendor":{"type":"string"},"date":{"type":"string","description":"YYYY-MM-DD"},"time":{"type":"string","description":"HH:MM 24h; needs a date"},"source":{"type":"string"},"notes":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},"milestone":{"type":"boolean","description":"a notable step for the milestones history"},"completed":{"type":"string","description":"YYYY-MM-DD it was done; set automatically when status becomes done"},"archived":{"type":"boolean"}},"required":["id"]}}},{"type":"function","function":{"name":"search_entries","description":"Find entries by structured filters and/or words. All filters are optional and combine with AND; list filters match any of their values (tags must all match).","parameters":{"type":"object","properties":{"kinds":{"type":"array","items":{"type":"string","enum":["idea","decision","task","note","question"]}},"rooms":{"type":"array","items":{"type":"string","enum":["living","dining","dry kitchen","wet kitchen","flex","master bedroom","bedroom 2","bedroom 3","master bathroom","bathroom 2","balcony","whole-house"]}},"statuses":{"type":"array","items":{"type":"string","enum":["idea","shortlisted","decided","done","todo","doing"]}},"category":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},"vendor":{"type":"string"},"text":{"type":"string","description":"words that must all appear in the entry"},"date_from":{"type":"string","description":"YYYY-MM-DD"},"date_to":{"type":"string","description":"YYYY-MM-DD"},"milestone":{"type":"boolean","description":"true: only milestones (flagged and done); false: leave them out"},"include_archived":{"type":"boolean"},"limit":{"type":"integer"}}}}},{"type":"function","function":{"name":"set_dates","description":"Set the move-in date and/or the key collection date (YYYY-MM-DD). Pass only the ones that change.","parameters":{"type":"object","properties":{"move_in":{"type":"string"},"key_collection":{"type":"string"}}}}},{"type":"function","function":{"name":"undo_change","description":"Undo a change. Without change_id, undoes the latest change by the person asking.","parameters":{"type":"object","properties":{"change_id":{"type":"string"}}}}}]}