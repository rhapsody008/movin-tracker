# Copy to .env (make dev does this for you and fills SETTINGS_SECRET).
# .env is git-ignored.

# --- S3: the one real bucket. Dev and production share it (no prefix), so
# whatever you do locally changes your real data. Keys: any AWS key that can
# read, write, list and delete in the bucket. `make test` uses its own MinIO, never these. ---
S3_BUCKET=
S3_PREFIX=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM: OpenAI-compatible only (v3; Settings → LLM on the web page overrides
# these). Any endpoint that speaks /v1/chat/completions: the NAI gateway, vMLX,
# Ollama, OpenAI itself. There is no Claude kind any more (LLM_KIND=claude
# refuses to start) ---
# Local vMLX/Ollama on this Mac, seen from inside Docker:
#   LLM_BASE_URL=http://host.docker.internal:8081/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_STREAMING=true
# Thinking models (Qwen3 on vMLX/vLLM): think only for messages that start
# with /think. Not for OpenAI.
# LLM_THINK_ON_DEMAND=true

# Fernet key that encrypts the API key saved on the web page (Settings → LLM).
# Dev and production share settings.json, so use the same key in both and
# keep it stable; with a different key the saved LLM key can't be read.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
SETTINGS_SECRET=

# --- Auth ---
AUTH_HEADER=X-Forwarded-Email
ALLOWED_EMAILS=
# Local dev only: the user to act as when no proxy sets AUTH_HEADER.
# Never set this in production.
DEV_EMAIL=dev@localhost

# --- Telegram (the bot runs only when the token is set) ---
# Token from @BotFather (/newbot). Also run /setprivacy → Disable so the bot
# sees ordinary messages in your group. Only one running copy may use a token:
# once production runs the bot, leave this empty locally.
TELEGRAM_BOT_TOKEN=
# Default allowlist; Settings → Telegram on the web page replaces it.
# People as id=name (the name is what entries show as "by"):
TELEGRAM_ALLOWED_IDS=
# Group chat IDs (they start with -):
TELEGRAM_ALLOWED_CHATS=

# --- Documents (PDFs under docs/raw/ in the bucket) ---
# Daily re-read at this time (HH:MM in TZ), or off. They also sync at startup and on /sync.
# DOCS_SYNC_SCHEDULE=03:00

# --- Morning check-in (Telegram; needs TELEGRAM_BOT_TOKEN) ---
# Daily message with today's and yesterday's tasks (HH:MM in TZ, before 20:00), or off.
# If the app wasn't running then, it goes out when the app starts, until 20:00.
# CHECKIN_SCHEDULE=09:30
# Where it goes; default: the first allowed group, else the first allowed person.
# CHECKIN_CHAT=

TZ=Asia/Singapore
# LISTEN_ADDR=:8080
# LOG_LEVEL=info

# --- Storage and identity of this deployment ---
# Where the durable harness's SQLite file lives (chat history). The k8s pod
# mounts its volume here; a compose or local run needs no change.
# DATA_DIR=/data
# This deployment's own S3 start counter (harness/dev/epoch.json). Required by
# serve: prod sets `prod` in the prod overlay, so the two never share one.
# MOVIN_INSTANCE=dev
